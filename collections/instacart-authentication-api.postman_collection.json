      "id": "e48459f8-c70a-4f56-a235-3d3ce5201622",
      "name": "Authentication",
      "description": {
        "content": "Endpoints for obtaining and managing OAuth 2.0 access tokens used to authenticate API requests.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "28b21715-6aa8-4aa1-b881-6c3a6b8af358",
          "name": "Generate an access token",
          "request": {
            "name": "Generate an access token",
            "description": {
              "content": "Generates an OAuth 2.0 access token using client credentials. The token is valid for 24 hours and must be included as a Bearer token in all subsequent API requests. During the validity period, reuse the same token rather than generating a new one.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "oauth",
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grant_type\": \"<string>\",\n  \"client_id\": \"<string>\",\n  \"client_secret\": \"<string>\",\n  \"scope\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "86424e4f-ebfd-44f8-8995-8dee32dd764d",
              "name": "Access token generated successfully",
              "originalRequest": {
                "url": {
                  "path": [
                    "v2",
                    "oauth",
                    "token"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: bearer",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Bearer <token>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
