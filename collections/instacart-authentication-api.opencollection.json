{
  "opencollection": "1.0.0",
  "info": {
    "name": "Instacart Catalog Authentication API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Generate an access token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://connect.instacart.com/v2/oauth/token",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Generates an OAuth 2.0 access token using client credentials. The token is valid for 24 hours and must be included as a Bearer token in all subsequent API requests. During the validity period, reuse the same token rather than generating a new one."
        }
      ]
    }
  ],
  "bundled": true
}