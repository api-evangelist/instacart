      "name": "Replacements",
      "description": {
        "content": "Endpoints for managing item replacements suggested by shoppers during order fulfillment.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "f7dadff0-e73a-4177-984f-fff845c8da65",
          "name": "Approve or reject an item replacement",
          "request": {
            "name": "Approve or reject an item replacement",
            "description": {
              "content": "Approves or rejects a replacement suggested by the shopper for a specific order item. If the customer approves the replacement, specify the status as APPROVED. If the customer rejects the replacement, specify the status as REJECTED. Items with a rejected replacement are automatically refunded.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "post_checkout",
                "orders",
                ":order_id",
                "items",
